---
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
import ServiceStages from '../components/ServiceStages.astro';
import Underpinned from '../components/Underpinned.astro';
import WhoWeAre from '../components/WhoWeAre.astro';
import CaseStudies from '../components/CaseStudies.astro';
import Values from '../components/Values.astro';
import Why from '../components/Why.astro';
import WhoWeWorkWith from '../components/WhoWeWorkWith.astro';
import Talk from '../components/Talk.astro';
import WhatWeAre from '../components/WhatWeAre.astro';
import tumlaUrl from '../assets/fonts/tumla-bold.woff2?url';
import albertUrl from '../assets/fonts/albert-sans-vf.woff2?url';
import heroesImg from '../assets/images/cases/help-for-heroes-christmas.jpg';
import grantifyImg from '../assets/images/cases/trial-grantify.webp';
import loveLogicImg from '../assets/images/cases/trial-love-and-logic.webp';
import oliverImg from '../assets/images/founders/oliver-budworth.jpg';
import simonImg from '../assets/images/founders/simon-evans.jpg';

const nav = [
  { href: '#what-we-do', label: 'What we do' },
  { href: '#work', label: 'Work' },
  { href: '#talk', label: 'Talk to us' },
];

const sectors = ['Charities', 'Manufacturers', 'Software companies', 'Start-ups', 'Institutions'];

const stages = [
  {
    n: '01',
    name: 'Strategy',
    line: 'Working out where you fit now.',
    body: "Before anything gets made, we work out what's actually changed and what you need to become because of it. That might mean research, talking to customers and staff, a hard look at the numbers or a couple of uncomfortable workshops. What comes out is a clear direction and a plan to get there, written so people can act on it.",
  },
  {
    n: '02',
    name: 'Orchestration',
    line: 'Getting everything pointing the same way.',
    body: "Change rarely sits neatly in one department. We map how your organisation works today, its services, journeys, teams and systems, and design how it needs to work tomorrow. That way brand, service design, marketing and technology pull in the same direction, and you don't end up with four separate briefs that never meet.",
  },
  {
    n: '03',
    name: 'Production',
    line: 'Making the thing.',
    body: "Brands, campaigns, content, websites, digital products and tools. We make them ourselves and don't hand a brief to someone else, so the idea that was agreed is the one that gets built.",
  },
  {
    n: '04',
    name: 'Activation',
    line: 'Putting it into the world.',
    body: "A good idea nobody notices doesn't change anything. We launch it, get it in front of the right people and make sure it's chosen and used. This covers campaigns and channels, and also the internal side; your own people need to get behind it as much as your customers do.",
  },
  {
    n: '05',
    name: 'Management',
    line: 'Keeping it running.',
    body: "Once something is live, it needs looking after. We manage channels, content, campaigns and platforms day to day as an extension of your team, and we step back when we're no longer useful.",
  },
  {
    n: '06',
    name: 'Optimisation',
    line: 'Making it better.',
    body: "We measure what's working and what isn't, then keep adjusting. Standing still is no better six months after launch than it was before we started.",
  },
];

const values = [
  {
    n: '01',
    title: 'We start with the problem, not the discipline.',
    body: "We'll use whichever of brand, service design, marketing or technology gets you there, and we won't pretend the answer is the thing we happen to enjoy making.",
  },
  {
    n: '02',
    title: 'We say the uncomfortable thing early.',
    body: "You're paying for a point of view, not agreement, so you'll hear it in the first meeting and not the last. We'd rather lose a job than win it by nodding.",
  },
  {
    n: '03',
    title: 'We build what we recommend.',
    body: "Advice that stays in a deck hasn't changed anything. If we wouldn't build it, we don't recommend it.",
  },
  {
    n: '04',
    title: 'We earn it.',
    body: "We don't take credit for things we didn't do, and we don't blame the market for things we did.",
  },
];

const cases = [
  {
    client: 'Help for Heroes',
    sector: 'Charities',
    /* No case study pages yet. */
    href: '#',
    /* From helpforheroes.org.uk (Christmas 2026 campaign): confirm
       permission to use before launch. */
    image: heroesImg,
    title: 'From everyone-for-everything to one journey, with a named person on the end of it.',
    body: "The brief was for a shared vision. What they needed was an operating model, so we said so. It's being implemented now, held to first contact within one working day, a named contact within 24 hours and a confirmed plan within ten days.",
  },
  {
    client: 'Grantify',
    sector: 'Software companies',
    href: '#',
    /* Trial only: a moodboard reference, not cleared for use. Replace
       with Grantify's own imagery before launch. */
    image: grantifyImg,
    title: 'From no marketing and paused spend to a demand engine where over half the leads are the right companies.',
    body: "While the product had moved, the marketing hadn't. So we built it. The first campaign turned 184 visitors into 85 accounts and 42 calls, and for the first time over half the leads were the right kind of company.",
  },
  /* Draft copy: check the facts before launch. */
  {
    client: 'Love & Logic',
    sector: 'Brand consultancy',
    href: '#',
    /* Trial only: a moodboard reference, not cleared for use. */
    image: loveLogicImg,
    title: 'From a good reputation passed on by word of mouth to a clear position that brings the right work in.',
    body: "Love & Logic had the clients and the craft, but the way it described itself hadn't kept up with the work. We worked out where it fits now and built the brand and site to say so.",
  },
];

const email = 'hello@andwethrive.co.uk';
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Both fonts are wanted straight away, so fetch them alongside the
         page rather than after the styles are read. -->
    <link rel="preload" href={tumlaUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={albertUrl} as="font" type="font/woff2" crossorigin />
    <title>Thrive | A strategy company for organisations on the move</title>
    <meta
      name="description"
      content="Thrive is a strategy company for organisations on the move. We help you work out where you fit now, then focus on how to get there."
    />
    <style is:global>
      @font-face {
        font-family: 'Tumla';
        src: url('../assets/fonts/tumla-bold.woff2') format('woff2');
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Albert Sans';
        src: url('../assets/fonts/albert-sans-vf.woff2') format('woff2');
        font-weight: 100 900;
        font-display: swap;
      }
      /* Side padding for every section's content. Wider screens get more
         room at the edges, so lines don't run so close to the window. */
      :root {
        --pad-x: clamp(20px, 4vw, 80px);
        /* How far down anything held in place while scrolling should sit,
           to clear the fixed header bar with a little space under it. */
        --header-clear: clamp(84px, calc(5.2vw + 12px), 110px);
        /* The scrolled header bar's height (it sits flush with the top of
           the window): its button height plus its padding. */
        --header-h: calc(max(44px, 2.6 * clamp(15px, 1.15vw, 20px)) + 0.5 * clamp(15px, 1.15vw, 20px));
      }
      /* From small desktops up: 8% of the width, so 82px at 1024 and
         115px at 1440, rising to 200px on very wide screens. */
      @media (min-width: 1024px) {
        :root {
          --pad-x: clamp(64px, 8vw, 200px);
        }
      }
      body {
        margin: 0;
        font-family: 'Albert Sans', system-ui, sans-serif;
        /* Navy for text that isn't set otherwise, never black. */
        color: #182235;
        /* White behind everything, so rounded section corners read
           cleanly whatever the browser's own background. */
        background: #fff;
      }
      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        font-family: 'Tumla', 'Albert Sans', system-ui, sans-serif;
        font-weight: 700;
      }
      /* One line height for every h2, as on the hero headline. */
      h2 {
        line-height: 1.05;
      }
      /* Form controls don't take the page's font by default. */
      button,
      input,
      select,
      textarea {
        font: inherit;
      }
      /* A section's heading and short intro, lined up with the content
         below it. Same heading size as the case studies. */
      .section-intro {
        padding: clamp(56px, 7vw, 120px) var(--pad-x) 0;
      }
      .section-intro h2 {
        margin: 0;
        color: #182235;
        font-size: clamp(36px, 4.4vw, 72px);
        line-height: 1.05;
        letter-spacing: -0.01em;
      }
      .section-intro p {
        max-width: 40em;
        margin: clamp(16px, 1.6vw, 24px) 0 0;
        font-size: clamp(18px, 1.5vw, 24px);
        line-height: 1.26;
        text-wrap: pretty;
      }
      /* Services framework: on the brand's cream, all four corners
         rounded. Orange behind the top ones, running on from the orange
         round "What we are" above; navy behind the bottom ones, running on
         into the navy "Four things" section below. */
      .services-wrap {
        background: linear-gradient(#eb573d 50%, #182235 50%);
      }
      #what-we-do {
        background: #fff2e6;
        color: #182235;
        display: flow-root;
        border-radius: clamp(16px, 1.8vw, 28px);
      }
    </style>
  </head>
  <body>
    <main>
      <Hero />

      <!-- Why we're here -->
      <Why
        kicker="Why we're here"
        heading="When you no longer fit where you are, you need to move."
        lines={[
          "It might be that the market's shifted, your existing model has stopped working, or the thing you were built for isn't quite the thing anymore.",
          'We help you work out where you fit now, and then focus on how to get there.',
          "Because business works better when you don't stand still.",
        ]}
      />

      <!-- Who we work with -->
      <WhoWeWorkWith
        kicker="Who we work with"
        heading={"Nobody rings us when\neverything's fine."}
        sectors={sectors}
        lead="The organisations we work with don't have much in common. What they share is a moment; the market's moved, the model has stopped paying, a service needs redesigning, or a product has to launch into a world that changed while it was being built."
        cta={{ label: 'Find out more', href: '#what-we-do' }}
      />


      <!-- What we are -->
      <WhatWeAre
        kicker="We're a strategy company"
        heading="We start with what your organisation needs to become, and then work out what it will take to get you there."
        body={[
          "That might be building a stronger brand, reimagining your core service, changing how you reach customers or launching a new product, and it's often more than one of these with every piece of work.",
          "We don't arrive with an answer in mind, and if what you need is a change to how you work rather than a campaign, we'll say so.",
        ]}
        close="The strategy isn't finished until something has changed."
      />

      <!-- What we do: services framework -->
      <div class="services-wrap">
      <section id="what-we-do">
        <div class="section-intro">
          <h2>Our services framework.</h2>
          <p>
            The work runs in order. Strategy comes first and each stage sets up the next, through to
            optimisation. Where you join depends on what you already have in place.
          </p>
        </div>

        <ServiceStages stages={stages} />

        <Underpinned
          label="Our framework is underpinned by:"
          pillars={[
            {
              name: 'Technology & data',
              text: 'We use technology and data to augment, accelerate and amplify the work we do.',
            },
            {
              name: 'Creativity & craft',
              text: 'We use creativity to solve problems and bring craft to everything we produce.',
            },
          ]}
        />
      </section>
      </div>


      <!-- Values -->
      <Values heading="Four things you can hold us to." values={values} />

      <!-- Work -->
      <CaseStudies heading="Organisations that moved." cases={cases} />

      <!-- Who we are -->
      <WhoWeAre
        kicker="Who we are"
        heading="Small, senior and still there the night before launch."
        body={[
          "Thrive was started in 2025 by Oliver Budworth and Simon Evans, on the basis that we'd never be tied to a commercial agenda for what the answer should be.",
          'Behind that sits 27 years of marketing, brand, advertising and customer experience strategy, in every category from charities to cat food and sports to software. Around the two of us is a small team covering strategy, design, software engineering and performance.',
          "We build our own tools as readily as we build yours, mostly because we can't leave things alone. And we finish things, which includes the live bit, the measuring bit and the making-it-better bit.",
        ]}
        people={[
          {
            name: 'Oliver Budworth',
            role: 'Co-founder',
            photo: oliverImg,
            bg: '#EB573D',
            ink: '#F9E07A',
          },
          {
            name: 'Simon Evans',
            role: 'Co-founder',
            photo: simonImg,
            bg: '#C6ECE2',
            ink: '#182235',
          },
        ]}
      />

      <!-- Talk to us -->
      <Talk
        heading="You don't need a brief."
        body={[
          "Most people who get in touch don't have one yet, and being honest that's usually when we're most useful.",
          "Tell us what's changed and what's stopped working. We'll tell you what we think, including if we think you don't need us.",
        ]}
        email={email}
      />
    </main>

    <Footer nav={nav} email={email} />
    <script>
      import '../scripts/smoothScroll';
    </script>
  </body>
</html>

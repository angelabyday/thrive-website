---
/* Big footer: "We thrive on Change", whose letters turn into glass shapes
   under the pointer (or on tap), from the brand document's
   "Change: letters to 3D glass shapes" sheet. Then the site's details. */
interface Props {
  nav: { href: string; label: string }[];
  email: string;
}
const { nav, email } = Astro.props;
const ground = '#C6ECE2';
const letters = Array.from('Change');
---

<footer class="footer">
  <div class="footer-change" data-change data-ground={ground}>
    <div class="change-stack">
      <p class="change-kicker">We thrive on</p>
      <p class="change-word" data-word>
        <span class="visually-hidden">Change</span>
        {
          letters.map((c) => (
            <span class="change-letter" data-letter aria-hidden="true">
              <span class="change-glyph" data-glyph>{c}</span>
            </span>
          ))
        }
      </p>
    </div>
    <div class="change-depth" data-depth aria-hidden="true"></div>
  </div>

  <div class="footer-info">
    <a href="#top" class="footer-logo" aria-label="Thrive, back to top"></a>

    <div class="footer-col">
      <p class="footer-label">Keep exploring</p>
      <nav aria-label="Footer">
        <ul>
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>
    </div>

    <div class="footer-col">
      <p class="footer-label">Talk to us</p>
      <p><a href={`mailto:${email}`}>{email}</a></p>
      <p>Thrive, The Quad, 1 Station Hill Square, Reading, RG1 1LN</p>
    </div>

    <p class="footer-legal">Thrive is the trading name of &amp; We Thrive Limited.</p>
  </div>
</footer>

<script>
  import { mountChangeWord } from '../scripts/glass/changeWord';

  /* Only where there's a pointer to hover with: on touch screens
     (phones, tablets) the word stays as type, which also saves the phone
     drawing another 3D canvas. */
  const change = document.querySelector<HTMLElement>('[data-change]');
  const touch = window.matchMedia('(pointer: coarse)').matches;
  if (change && !touch) mountChangeWord(change, change.dataset.ground ?? '#C6ECE2');
</script>

<style>
  .footer {
    --ink: #182235;
    --ground: #c6ece2;
    /* Rounded at the top, tucked up over the cream round "Talk to us" so
       the cream shows behind the corners. */
    --round: clamp(16px, 1.8vw, 28px);
    position: relative;
    margin-top: calc(-1 * var(--round));
    border-radius: var(--round) var(--round) 0 0;
    background: var(--ground);
    color: var(--ink);
    font-family: 'Albert Sans', system-ui, sans-serif;
  }

  /* The word, centred in a tall band, with the canvas laid over it in
     the same grid cell, letting the pointer through to the letters. */
  .footer-change {
    display: grid;
    place-items: center;
    /* Room for the kicker above and the g's tail below, and no more. */
    padding-block: clamp(88px, 8vw, 160px) clamp(56px, 5vw, 104px);
    overflow: hidden;
  }

  .footer-change > * {
    grid-area: 1 / 1;
  }

  .change-stack {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .change-kicker {
    position: absolute;
    bottom: 100%;
    left: 50%;
    translate: -50% 0;
    margin: 0 0 0.25em;
    white-space: nowrap;
    font-size: clamp(22px, 2.16vw, 36px);
    line-height: 1.2;
  }

  .change-word {
    margin: 0;
    font-family: 'Tumla', 'Albert Sans', system-ui, sans-serif;
    font-weight: 700;
    font-size: min(20vw, 30svh);
    line-height: 1;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .change-letter {
    position: relative;
    display: inline-block;
    cursor: default;
  }

  .change-glyph {
    display: inline-block;
  }

  .change-depth {
    position: relative;
    z-index: 2;
    place-self: stretch;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .change-depth :global(canvas) {
    position: absolute;
    inset: 0;
    display: block;
  }

  /* The details: logo, links and contact, then the legal line. */
  .footer-info {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    padding: clamp(32px, 4vw, 64px) var(--pad-x) clamp(24px, 3vw, 48px);
    border-top: 1px solid rgb(24 34 53 / 0.15);
    font-size: clamp(16px, 1.1vw, 18px);
    line-height: 1.26;
  }

  @media (min-width: 768px) {
    .footer-info {
      grid-template-columns: 1.4fr 1fr 1fr;
      align-items: start;
    }
  }

  .footer-logo {
    display: block;
    width: clamp(120px, 10vw, 180px);
    aspect-ratio: 631.6 / 144.62;
    background: var(--ink);
    mask: url('../assets/thrive-logo.svg') no-repeat left center / contain;
    -webkit-mask: url('../assets/thrive-logo.svg') no-repeat left center / contain;
  }

  .footer-col p,
  .footer-col ul {
    margin: 0 0 0.5em;
  }

  .footer-col ul {
    padding: 0;
    list-style: none;
  }

  .footer-col li + li {
    margin-top: 0.35em;
  }

  .footer-label {
    font-weight: 700;
  }

  .footer a {
    color: inherit;
    text-decoration: none;
  }

  .footer-col a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .footer a:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  .footer-legal {
    grid-column: 1 / -1;
    margin: 0;
    padding-top: 24px;
    border-top: 1px solid rgb(24 34 53 / 0.15);
    font-size: 14px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

---
/* Case studies as a grid of square tiles with rounded corners, each with
   a small badge, the client's name and its sector underneath. Each tile
   takes an image when there is one; until then it shows the case's
   headline on a brand colour. The whole card links to the full story. */
interface Case {
  client: string;
  sector: string;
  title: string;
  href: string;
  /* A photo or still for the tile, when there is one. */
  image?: string;
}
interface Props {
  heading: string;
  cases: Case[];
}
const { heading, cases } = Astro.props;

/* Tile colours in turn, ground and ink. */
const looks = [
  { bg: '#EB573D', ink: '#F9E07A' },
  { bg: '#C6ECE2', ink: '#182235' },
  { bg: '#F9E07A', ink: '#EB573D' },
];
---

<section class="cases" id="work">
  <h2 class="cases-heading">{heading}</h2>
  <ul class="cases-grid">
    {
      cases.map((c, i) => {
        const look = looks[i % looks.length];
        return (
          <li>
            <a class="case" href={c.href} style={`--bg: ${look.bg}; --ink: ${look.ink}`}>
              <div class="case-tile">
                {c.image ? (
                  <>
                    <img src={c.image} alt="" loading="lazy" />
                    <div class="case-panel">
                      <p class="case-panel-title">{c.title}</p>
                    </div>
                  </>
                ) : (
                  <p class="case-title">{c.title}</p>
                )}
              </div>
              <div class="case-meta">
                <span class="case-badge" aria-hidden="true">
                  {c.client.charAt(0)}
                </span>
                <span class="case-text">
                  <h3 class="case-name">{c.client}</h3>
                  <span class="case-sector">{c.sector}</span>
                </span>
              </div>
            </a>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .cases {
    /* Rounded at the top, tucked up over the navy section above so the
       navy shows behind the corners. */
    --round: clamp(16px, 1.8vw, 28px);
    position: relative;
    margin-top: calc(-1 * var(--round));
    padding: calc(clamp(56px, 7vw, 120px) + var(--round)) var(--pad-x) clamp(56px, 7vw, 120px);
    border-radius: var(--round) var(--round) 0 0;
    background: #fff2e6;
    color: #182235;
  }

  .cases-heading {
    margin: 0 0 clamp(24px, 3vw, 48px);
    color: #182235;
    font-size: clamp(36px, 4.4vw, 72px);
    line-height: 1.05;
    letter-spacing: -0.01em;
  }

  .cases-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(32px, 3vw, 48px) clamp(16px, 2vw, 32px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .case {
    display: block;
    color: inherit;
    text-decoration: none;
    border-radius: 28px;
  }

  .case:focus-visible {
    outline: 3px solid #182235;
    outline-offset: 4px;
  }

  /* The square tile. */
  .case-tile {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: clamp(20px, 2vw, 32px);
    background: var(--bg);
    color: var(--ink);
  }

  .case-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: scale 0.6s cubic-bezier(0.3, 0.7, 0.2, 1);
  }

  .case:hover .case-tile img {
    scale: 1.04;
  }

  /* Until there's an image: the headline, set large in the tile. */
  .case-title {
    container-type: inline-size;
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    margin: 0;
    padding: 9%;
    font-family: 'Tumla', 'Albert Sans', system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(22px, 2.2vw, 36px);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-wrap: balance;
    transition: translate 0.6s cubic-bezier(0.3, 0.7, 0.2, 1);
  }

  .case:hover .case-title {
    translate: 0 -6px;
  }

  /* On a photo: the headline on a card that rises over the lower half of
     the tile on hover or keyboard focus. Where there's no hover (phones,
     tablets), it stays up. */
  .case-panel {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    height: calc(50% - 12px);
    box-sizing: border-box;
    display: flex;
    align-items: flex-end;
    padding: 7%;
    border-radius: clamp(14px, 1.4vw, 22px);
    background: var(--bg);
    color: var(--ink);
    translate: 0 calc(100% + 12px);
    transition: translate 0.5s cubic-bezier(0.3, 0.7, 0.2, 1);
  }

  .case:hover .case-panel,
  .case:focus-visible .case-panel {
    translate: 0 0;
  }

  @media (hover: none) {
    .case-panel {
      translate: 0 0;
    }
  }

  .case-panel-title {
    margin: 0;
    font-family: 'Tumla', 'Albert Sans', system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(20px, 1.9vw, 30px);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  /* Badge, name and sector under the tile. */
  .case-meta {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 16px;
  }

  .case-badge {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Tumla', 'Albert Sans', system-ui, sans-serif;
    font-weight: 700;
    font-size: 24px;
    line-height: 1;
  }

  .case-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .case-name {
    margin: 0;
    font-family: 'Tumla', 'Albert Sans', system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(18px, 1.4vw, 22px);
    line-height: 1.2;
  }

  .case-sector {
    font-size: clamp(15px, 1.1vw, 17px);
    line-height: 1.04;
    color: rgb(24 34 53 / 0.65);
  }

  @media (max-width: 1023px) {
    .cases-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 639px) {
    .cases-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .case-tile img,
    .case-title {
      transition: none;
    }
    /* No rising: the card fades in where it sits. */
    .case-panel {
      translate: 0 0;
      opacity: 0;
      transition: opacity 0.2s linear;
    }
    .case:hover .case-panel,
    .case:focus-visible .case-panel {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) and (hover: none) {
    .case-panel {
      opacity: 1;
    }
  }
</style>

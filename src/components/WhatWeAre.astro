---
/* "What we are": a rounded cream panel with navy type, set on orange. The label, then the heading across the panel; under
   it, two short paragraphs side by side; then a closing
   statement set big across the full width. On narrow screens it's one
   column. */
interface Props {
  kicker: string;
  heading: string;
  body: string[];
  close: string;
}
const { kicker, heading, body, close } = Astro.props;

/* The closing statement's last word ("changed") starts as three glass
   shapes, morphing from one shape into another, which give way to the
   word once the line has scrolled into view. */
const m = close.match(/^(.*\s)(\S+?)(\W*)$/);
const [before, word, after] = m ? [m[1], m[2], m[3]] : [close, '', ''];
/* Set on two fixed lines, broken before "until". */
const cut = before.indexOf(' until ');
const [first, rest] = cut > 0 ? [before.slice(0, cut), before.slice(cut + 1)] : ['', before];
/* Each of the three shapes morphs through its own set. */
const shapes = ['seal,clover,donut', 'plus,sunburst,domes', 'flower,diamond,spokes'];
---

<section id="what-we-are" class="wwa">
  <div class="wwa-panel">
    <div class="wwa-head">
      <p class="wwa-kicker">{kicker}</p>
      <h2 class="wwa-heading">{heading}</h2>
    </div>

    <div class="wwa-columns">
      {body.map((p) => <p>{p}</p>)}
    </div>

    <p class="wwa-close" data-wwa-change>
      {first && <span class="wwa-line">{first}</span>}{first && ' '}<span class="wwa-line">{rest}<span class="wwa-word">
        <span class="wwa-word-text" data-wwa-text>{word}</span>
        <span class="wwa-shapes" aria-hidden="true">
          {shapes.map((cycle) => (
            <span class="wwa-shape" data-wwa-shape data-glass={cycle.split(',')[0]} data-glass-cycle={cycle} data-ground="#FFF2E6" />
          ))}
        </span>
      </span>{after}</span>
      <canvas class="wwa-canvas" aria-hidden="true"></canvas>
    </p>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { mountGlass } from '../scripts/glass/glass';

  gsap.registerPlugin(ScrollTrigger);

  /* Where "changed" goes, three glass shapes sit, each morphing into
     the next of its set. Once the line has come up the screen and they've
     had a few seconds, they shrink away one after another and the word
     takes their place. Scrolling back down past the line puts the shapes
     back, ready to go again. Without the script, or with reduced motion,
     it's just the word (a shape shrunk to nothing isn't drawn). */
  const close = document.querySelector<HTMLElement>('[data-wwa-change]');
  const canvas = close?.querySelector<HTMLCanvasElement>('.wwa-canvas');
  const text = close?.querySelector<HTMLElement>('[data-wwa-text]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (close && canvas && text && !reduce) {
    const shapes = [...close.querySelectorAll<HTMLElement>('[data-wwa-shape]')];
    mountGlass(close, canvas);
    const showShapes = () => {
      gsap.set(shapes, { scale: 1 });
      gsap.set(text, { autoAlpha: 0, scale: 0.9 });
    };
    showShapes();
    let tl: ReturnType<typeof gsap.timeline> | null = null;
    ScrollTrigger.create({
      trigger: close,
      start: 'top 75%',
      onEnter: () => {
        tl?.kill();
        tl = gsap.timeline({ delay: 4.2 });
        tl.to(shapes, { scale: 0, duration: 0.4, ease: 'back.in(1.6)', stagger: 0.1 });
        tl.to(text, { autoAlpha: 1, scale: 1, duration: 0.5, ease: 'back.out(1.6)' }, '-=0.15');
      },
      onLeaveBack: () => {
        tl?.kill();
        showShapes();
      },
    });
  }
</script>

<style>
  .wwa {
    --gutter: clamp(24px, 3vw, 48px);
    padding: var(--gutter);
    background: #eb573d;
  }

  .wwa-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    grid-template-areas:
      'head head'
      'copy copy'
      'close close';
    gap: clamp(24px, 2.4vw, 40px) clamp(24px, 4vw, 72px);
    /* Less the gap round the panel, so the content lines up with the
       other sections. */
    padding: clamp(40px, 6vw, 112px) max(16px, calc(var(--pad-x) - var(--gutter)));
    border-radius: clamp(16px, 1.8vw, 28px);
    background: #fff2e6;
    color: #182235;
  }

  .wwa-head {
    grid-area: head;
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 1.6vw, 24px);
  }

  .wwa-kicker {
    margin: 0;
    /* Same as the other section labels. */
    font-size: clamp(16px, 1.3vw, 20px);
  }

  .wwa-heading {
    max-width: 18em;
    margin: 0;
    font-size: clamp(32px, 4vw, 72px);
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  /* Directly under the heading, from its left edge, about as wide as it. */
  .wwa-columns {
    grid-area: copy;
    max-width: 60rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px clamp(24px, 3vw, 48px);
    font-size: clamp(17px, 1.3vw, 20px);
    line-height: 1.5;
  }

  .wwa-columns p {
    margin: 0;
    text-wrap: pretty;
  }

  /* The closing statement, big, across the panel. */
  .wwa-close {
    grid-area: close;
    max-width: 24em;
    /* More room above the closing statement than between the heading
       and its paragraphs. */
    margin: clamp(16px, 2.4vw, 40px) 0 0;
    font-family: 'Tumla', 'Albert Sans', system-ui, sans-serif;
    font-weight: 700;
    /* Smaller than the section's heading. */
    font-size: clamp(26px, 3vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.015em;
    text-wrap: balance;
    /* Holds the canvas the shapes are drawn on. */
    position: relative;
  }

  /* The word, with the three shapes laid over it in the same space, so
     nothing moves as one gives way to the other. */
  .wwa-word {
    position: relative;
    display: inline-block;
    white-space: nowrap;
  }

  .wwa-word-text {
    display: inline-block;
  }

  .wwa-shapes {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.12em;
    pointer-events: none;
  }

  .wwa-shape {
    display: block;
    flex: 0 0 auto;
    width: 1.05em;
    height: 1.05em;
    /* Shrunk to nothing (so not drawn) until the script shows them. */
    transform: scale(0);
  }

  /* Each line kept whole and on its own, from tablets up. On phones the
     lines are too long to keep, so they wrap. */
  @media (min-width: 640px) {
    .wwa-line {
      display: block;
      white-space: nowrap;
    }
  }

  /* The shapes' canvas, over the statement with room round it. */
  .wwa-canvas {
    position: absolute;
    inset: -0.5em -0.3em;
    width: calc(100% + 0.6em);
    height: calc(100% + 1em);
    pointer-events: none;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 899px) {
    .wwa-panel {
      grid-template-columns: 1fr;
      grid-template-areas:
        'head'
        'copy'
        'close';
    }
  }

  @media (max-width: 639px) {
    .wwa-columns {
      grid-template-columns: 1fr;
    }
  }
</style>

---
/* "What we are": a rounded cream panel with navy type, set on orange. The label, then the heading across the panel; under
   it, two short paragraphs side by side; then a closing
   statement set big across the full width. On narrow screens it's one
   column. */
interface Props {
  kicker: string;
  heading: string;
  body: string[];
  close: string;
}
const { kicker, heading, body, close } = Astro.props;

/* The closing statement, set on two fixed lines, broken before "until",
   its last word ("changed") picked out so it can change colour. */
const cut = close.indexOf(' until ');
const [first, tail] = cut > 0 ? [close.slice(0, cut), close.slice(cut + 1)] : ['', close];
const m = tail.match(/^(.*\s)(\S+?)(\W*)$/);
const [rest, word, after] = m ? [m[1], m[2], m[3]] : [tail, '', ''];
---

<section id="what-we-are" class="wwa">
  <div class="wwa-panel" data-wwa-panel>
    <div class="wwa-head">
      <p class="wwa-kicker">{kicker}</p>
      <h2 class="wwa-heading">{heading}</h2>
    </div>

    <div class="wwa-columns">
      {body.map((p) => <p>{p}</p>)}
    </div>

    <p class="wwa-close">
      {first && <span class="wwa-line">{first}</span>}{first && ' '}<span class="wwa-line">{rest}<span class="wwa-changed">{word}{after}</span></span>
    </p>
  </div>
</section>

<script>
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import gsap from 'gsap';

  gsap.registerPlugin(ScrollTrigger);

  /* The panel opens out like a card: it comes up the screen a little
     smaller, with rounder corners and more orange round it, and grows to
     its full size as it scrolls in, its corners easing to the usual
     radius. Scrolling back shrinks it again. With reduced motion it's
     simply there. */
  const panel = document.querySelector<HTMLElement>('[data-wwa-panel]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (panel && !reduce) {
    gsap.fromTo(
      panel,
      { scale: 0.74, borderRadius: () => Math.min(96, window.innerWidth * 0.06) },
      {
        scale: 1,
        borderRadius: () => Math.min(28, Math.max(16, window.innerWidth * 0.018)),
        ease: 'power1.inOut',
        scrollTrigger: {
          trigger: panel,
          start: 'top 95%',
          end: 'top 10%',
          scrub: true,
          invalidateOnRefresh: true,
        },
      },
    );
  }
</script>

<style>
  /* Desktop: the border round the panel a fifth wider. */
  @media (min-width: 1024px) {
    .wwa {
      --gutter: clamp(29px, 3.6vw, 58px) !important;
    }
  }

  .wwa {
    --gutter: clamp(24px, 3vw, 48px);
    padding: var(--gutter);
    background: #eb573d;
  }

  .wwa-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    grid-template-areas:
      'head head'
      'copy copy'
      'close close';
    gap: clamp(24px, 2.4vw, 40px) clamp(24px, 4vw, 72px);
    /* Less the gap round the panel, so the content lines up with the
       other sections. */
    padding: clamp(40px, 6vw, 112px) max(16px, calc(var(--pad-x) - var(--gutter)));
    border-radius: clamp(16px, 1.8vw, 28px);
    background: #fff2e6;
    color: #182235;
  }

  .wwa-head {
    grid-area: head;
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 1.6vw, 24px);
  }

  .wwa-kicker {
    margin: 0;
    /* Same as the other section labels. */
    font-size: clamp(16px, 1.3vw, 20px);
  }

  .wwa-heading {
    max-width: 18em;
    margin: 0;
    font-size: clamp(32px, 4vw, 72px);
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  /* Directly under the heading, from its left edge, about as wide as it. */
  .wwa-columns {
    grid-area: copy;
    max-width: 60rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px clamp(24px, 3vw, 48px);
    font-size: clamp(17px, 1.3vw, 20px);
    line-height: 1.2;
  }

  .wwa-columns p {
    margin: 0;
    text-wrap: pretty;
  }

  /* The closing statement, big, across the panel. */
  .wwa-close {
    grid-area: close;
    /* A rule across the panel above it, with room either side of the
       rule. */
    margin: clamp(16px, 2.4vw, 40px) 0 0;
    padding-top: clamp(24px, 3vw, 48px);
    border-top: 1px solid rgb(24 34 53 / 0.2);
    font-family: 'Tumla', 'Albert Sans', system-ui, sans-serif;
    font-weight: 700;
    /* Smaller than the section's heading. */
    font-size: clamp(26px, 3vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  /* "changed" on a rounded block that steps through the brand colours,
     each with its paired type colour: orange with yellow, yellow with
     orange, blue with navy, navy with blue. Still for reduced motion. */
  .wwa-changed {
    display: inline-block;
    padding: 0 0.14em 0.14em;
    border-radius: 0.18em;
    background: #eb573d;
    color: #f9e07a;
    animation: wwa-changed 4.8s steps(1, end) infinite;
  }

  @keyframes wwa-changed {
    0% {
      background: #eb573d;
      color: #f9e07a;
    }
    25% {
      background: #f9e07a;
      color: #eb573d;
    }
    50% {
      background: #c6ece2;
      color: #182235;
    }
    75% {
      background: #182235;
      color: #c6ece2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wwa-changed {
      animation: none;
    }
  }

  /* Each line kept whole and on its own, from tablets up. On phones the
     lines are too long to keep, so they wrap. */
  @media (min-width: 640px) {
    .wwa-line {
      display: block;
      white-space: nowrap;
    }
  }

  @media (max-width: 899px) {
    .wwa-panel {
      grid-template-columns: 1fr;
      grid-template-areas:
        'head'
        'copy'
        'close';
    }
  }

  @media (max-width: 639px) {
    .wwa-columns {
      grid-template-columns: 1fr;
      /* 30% less between paragraphs on phones. */
      row-gap: 17px;
    }
  }
</style>

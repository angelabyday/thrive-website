---
/* "What we are": a rounded cream panel with navy type, set on orange. The label, then the heading across the panel; under
   it, two short paragraphs side by side; then a closing
   statement set big across the full width. On narrow screens it's one
   column. */
interface Props {
  kicker: string;
  heading: string;
  body: string[];
  close: string;
}
const { kicker, heading, body, close } = Astro.props;

/* The closing statement's last word ("changed") turns into glass shapes
   as it scrolls past, like the footer's "Change". */
const m = close.match(/^(.*\s)(\S+?)(\W*)$/);
const [before, word, after] = m ? [m[1], m[2], m[3]] : [close, '', ''];
---

<section id="what-we-are" class="wwa">
  <div class="wwa-panel">
    <div class="wwa-head">
      <p class="wwa-kicker">{kicker}</p>
      <h2 class="wwa-heading">{heading}</h2>
    </div>

    <div class="wwa-columns">
      {body.map((p) => <p>{p}</p>)}
    </div>

    <p class="wwa-close" data-wwa-change>
      {before}<span class="wwa-word" data-word>
        <span class="visually-hidden">{word}</span>
        {
          Array.from(word).map((c) => (
            <span class="wwa-letter" data-letter aria-hidden="true">
              <span class="wwa-glyph" data-glyph>{c}</span>
            </span>
          ))
        }
      </span>{after}
      <span class="wwa-depth" data-depth aria-hidden="true"></span>
    </p>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { mountChangeWord } from '../scripts/glass/changeWord';

  gsap.registerPlugin(ScrollTrigger);

  /* As the closing statement scrolls up the screen, the letters of its
     last word turn into glass shapes one after another, then back into
     letters, in order, as it carries on up. Scrolling back down runs it
     in reverse. Each letter's window is a share of the scroll. With
     reduced motion the word stays as type. */
  const close = document.querySelector<HTMLElement>('[data-wwa-change]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (close && !reduce) {
    const word = mountChangeWord(close, '#FFF2E6', { pointer: false });
    const n = word.count;
    const on: boolean[] = [];
    ScrollTrigger.create({
      trigger: close,
      start: 'top 85%',
      end: 'bottom 15%',
      onUpdate: ({ progress: p }) => {
        for (let i = 0; i < n; i++) {
          const want = p > 0.2 + i * 0.04 && p < 0.62 + i * 0.04;
          if (want !== !!on[i]) {
            on[i] = want;
            word.swap(i, want);
          }
        }
      },
    });
  }
</script>

<style>
  .wwa {
    --gutter: clamp(24px, 3vw, 48px);
    padding: var(--gutter);
    background: #eb573d;
  }

  .wwa-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    grid-template-areas:
      'head head'
      'copy copy'
      'close close';
    gap: clamp(24px, 2.4vw, 40px) clamp(24px, 4vw, 72px);
    /* Less the gap round the panel, so the content lines up with the
       other sections. */
    padding: clamp(40px, 6vw, 112px) max(16px, calc(var(--pad-x) - var(--gutter)));
    border-radius: clamp(16px, 1.8vw, 28px);
    background: #fff2e6;
    color: #182235;
  }

  .wwa-head {
    grid-area: head;
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 1.6vw, 24px);
  }

  .wwa-kicker {
    margin: 0;
    /* Same as the other section labels. */
    font-size: clamp(16px, 1.3vw, 20px);
  }

  .wwa-heading {
    max-width: 18em;
    margin: 0;
    font-size: clamp(32px, 4vw, 72px);
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  /* Directly under the heading, from its left edge, about as wide as it. */
  .wwa-columns {
    grid-area: copy;
    max-width: 60rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px clamp(24px, 3vw, 48px);
    font-size: clamp(17px, 1.3vw, 20px);
    line-height: 1.5;
  }

  .wwa-columns p {
    margin: 0;
    text-wrap: pretty;
  }

  /* The closing statement, big, across the panel. */
  .wwa-close {
    grid-area: close;
    max-width: 24em;
    /* More room above the closing statement than between the heading
       and its paragraphs. */
    margin: clamp(16px, 2.4vw, 40px) 0 0;
    font-family: 'Tumla', 'Albert Sans', system-ui, sans-serif;
    font-weight: 700;
    /* Smaller than the section's heading. */
    font-size: clamp(26px, 3vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.015em;
    text-wrap: balance;
    /* Holds the canvas the shapes are drawn on. */
    position: relative;
  }

  /* The word, kept on one line, each letter in a box of its own that
     opens to a shape's width as the shape comes in. */
  .wwa-word {
    white-space: nowrap;
  }

  .wwa-letter,
  .wwa-glyph {
    display: inline-block;
  }

  /* Over the statement with room to spare round it, as the shapes tilt
     out past the letters. */
  .wwa-depth {
    position: absolute;
    inset: -0.6em -0.4em;
    pointer-events: none;
    overflow: hidden;
  }

  .wwa-depth :global(canvas) {
    position: absolute;
    inset: 0;
    display: block;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 899px) {
    .wwa-panel {
      grid-template-columns: 1fr;
      grid-template-areas:
        'head'
        'copy'
        'close';
    }
  }

  @media (max-width: 639px) {
    .wwa-columns {
      grid-template-columns: 1fr;
    }
  }
</style>

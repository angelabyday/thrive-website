---
/* "Who we are": the copy on the left, and the two founders as tall
   portrait cards side by side on the right, each with a name and role
   underneath. Until there are photos, each card is a flat brand-colour
   pair with the founder's initials set big; give a person a `photo` and
   it fills the card instead. One column on phones, the portraits after
   the heading. */
interface Person {
  name: string;
  role: string;
  photo?: string;
  bg: string;
  ink: string;
}
interface Props {
  kicker: string;
  heading: string;
  body: string[];
  people: Person[];
}
const { kicker, heading, body, people } = Astro.props;
const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((w) => w[0])
    .join('');
---

<section id="who-we-are" class="wwr">
  {/* The label on its own row, so the portraits line up with the top of
      the heading, not the label. */}
  <p class="wwr-kicker">{kicker}</p>
  <div class="wwr-copy">
    <h2 class="wwr-heading">{heading}</h2>
    <div class="wwr-body">
      {body.map((p) => <p>{p}</p>)}
    </div>
  </div>

  <ul class="wwr-people">
    {
      people.map((p) => (
        <li class="wwr-person">
          <div class="wwr-portrait" style={`--bg: ${p.bg}; --ink: ${p.ink}`}>
            {p.photo ? (
              <img src={p.photo} alt="" loading="lazy" />
            ) : (
              <span class="wwr-initials" aria-hidden="true">
                {initials(p.name)}
              </span>
            )}
            {/* Name and role on a panel over the bottom of the photo, as on
                the case study tiles, but always showing. */}
            <div class="wwr-panel">
              <p class="wwr-name">{p.name}</p>
              <p class="wwr-role">{p.role}</p>
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .wwr {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    grid-template-areas:
      'kicker .'
      'copy people';
    gap: clamp(16px, 1.6vw, 24px) clamp(32px, 5vw, 96px);
    align-items: start;
    padding: clamp(56px, 7vw, 120px) var(--pad-x);
    background: #fff2e6;
    color: #182235;
  }

  .wwr-copy {
    grid-area: copy;
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 1.6vw, 24px);
  }

  .wwr-kicker {
    grid-area: kicker;
    margin: 0;
    font-size: clamp(16px, 1.3vw, 20px);
  }

  .wwr-heading {
    margin: 0;
    font-size: clamp(32px, 3.6vw, 64px);
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .wwr-body {
    display: flex;
    flex-direction: column;
    gap: 1em;
    max-width: 34em;
    font-size: clamp(17px, 1.3vw, 20px);
    line-height: 1.5;
  }

  .wwr-body p {
    margin: 0;
    text-wrap: pretty;
  }

  .wwr-people {
    grid-area: people;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(12px, 1.5vw, 24px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The second portrait sits a little lower, so the pair is staggered. */
  .wwr-person:nth-child(2) {
    margin-top: clamp(24px, 4vw, 64px);
  }

  .wwr-portrait {
    container-type: inline-size;
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: clamp(16px, 1.8vw, 28px);
    background: var(--bg);
    color: var(--ink);
  }

  .wwr-portrait img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .wwr-initials {
    font-family: 'Tumla', 'Albert Sans', system-ui, sans-serif;
    font-weight: 700;
    font-size: 42cqw;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .wwr-panel {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    box-sizing: border-box;
    padding: clamp(12px, 1.2vw, 20px) clamp(14px, 1.4vw, 22px);
    border-radius: clamp(14px, 1.4vw, 22px);
    background: var(--bg);
    color: var(--ink);
  }

  .wwr-name {
    margin: 0;
    font-family: 'Tumla', 'Albert Sans', system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(20px, 1.8vw, 30px);
    line-height: 1.1;
  }

  .wwr-role {
    margin: 4px 0 0;
    font-size: clamp(15px, 1.1vw, 18px);
  }

  @media (max-width: 899px) {
    .wwr {
      grid-template-columns: 1fr;
      grid-template-areas:
        'kicker'
        'copy'
        'people';
      row-gap: clamp(16px, 1.6vw, 24px);
    }
    .wwr-people {
      margin-top: clamp(16px, 4vw, 32px);
    }
  }

  /* 30% less between paragraphs on phones, and a smaller name panel on
     the narrower photos. */
  @media (max-width: 639px) {
    .wwr-body {
      gap: 0.7em;
    }
    .wwr-panel {
      left: 8px;
      right: 8px;
      bottom: 8px;
      padding: 8px 10px;
      border-radius: 12px;
    }
    .wwr-name {
      font-size: 15px;
    }
    .wwr-role {
      margin-top: 2px;
      font-size: 13px;
    }
  }
</style>

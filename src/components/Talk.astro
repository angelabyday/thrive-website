---
/* "Talk to us": an orange panel, like the hero, so the page closes on the
   colour it opens with. The heading and copy on the left, the email
   address set large with a button to copy it, and a glass shape turning
   on the right. No form: people write to the address. */
interface Props {
  heading: string;
  body: string[];
  email: string;
}
const { heading, body, email } = Astro.props;
const ORANGE = '#EB573D';
---

<section id="talk" class="talk">
  <div class="talk-panel" data-glass-clip data-talk>
    <canvas class="talk-canvas" aria-hidden="true"></canvas>
    <span class="talk-glass" aria-hidden="true" data-glass="clover" data-gradient="3" data-ground={ORANGE}></span>

    <div class="talk-copy">
      <h2 class="talk-heading">{heading}</h2>
      {body.map((p) => <p class="talk-text">{p}</p>)}

      <div class="talk-email">
        <a class="talk-address" href={`mailto:${email}`}>{email}</a>
        <button type="button" class="talk-copy-button" data-copy={email}>
          <span data-copy-label>Copy email</span>
        </button>
        <span class="visually-hidden" aria-live="polite" data-copy-status></span>
      </div>
    </div>
  </div>
</section>

<script>
  import { mountGlass } from '../scripts/glass/glass';

  document.querySelectorAll<HTMLElement>('[data-talk]').forEach((panel) => {
    const canvas = panel.querySelector<HTMLCanvasElement>('.talk-canvas');
    if (canvas) mountGlass(panel, canvas);

    const button = panel.querySelector<HTMLButtonElement>('[data-copy]');
    const label = panel.querySelector<HTMLElement>('[data-copy-label]');
    const status = panel.querySelector<HTMLElement>('[data-copy-status]');
    if (!button || !label) return;
    let reset = 0;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        label.textContent = 'Copied';
        if (status) status.textContent = 'Email address copied';
      } catch {
        label.textContent = 'Press Ctrl or ⌘ + C';
      }
      window.clearTimeout(reset);
      reset = window.setTimeout(() => {
        label.textContent = 'Copy email';
        if (status) status.textContent = '';
      }, 2000);
    });
  });
</script>

<style>
  .talk {
    --gutter: clamp(24px, 3vw, 48px);
    padding: var(--gutter);
    background: #fff2e6;
  }

  .talk-panel {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    align-items: center;
    min-height: clamp(520px, 80svh, 860px);
    /* Less the gap round the panel, so the content lines up with the
       other sections. */
    padding: clamp(48px, 6vw, 112px) max(16px, calc(var(--pad-x) - var(--gutter)));
    border-radius: clamp(16px, 1.8vw, 28px);
    background: #eb573d;
    color: #f9e07a;
  }

  /* The shape's canvas over the whole panel, under the type. */
  .talk-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* Marks where the canvas draws the shape: the right-hand column,
     running off the panel's right edge. */
  .talk-glass {
    position: absolute;
    top: 50%;
    right: -6%;
    display: block;
    width: clamp(260px, 38vw, 680px);
    aspect-ratio: 1 / 1;
    translate: 0 -50%;
  }

  .talk-copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 1.6vw, 24px);
  }

  .talk-heading {
    margin: 0 0 clamp(8px, 1vw, 16px);
    font-size: clamp(40px, 5.6vw, 104px);
    letter-spacing: -0.01em;
  }

  .talk-text {
    max-width: 30em;
    margin: 0;
    font-size: clamp(18px, 1.5vw, 24px);
    line-height: 1.4;
    text-wrap: pretty;
  }

  /* The address, large, with the copy button beside it. */
  .talk-email {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    margin-top: clamp(16px, 2vw, 32px);
  }

  .talk-address {
    font-family: 'Tumla', 'Albert Sans', system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(26px, 3.2vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: #f9e07a;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color 0.2s ease;
  }

  .talk-address:hover {
    color: #fff2e6;
  }

  .talk-copy-button {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1.2em;
    border: 0;
    border-radius: 999px;
    background: #fff;
    color: #182235;
    font-size: clamp(15px, 1.1vw, 18px);
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  .talk-copy-button:hover {
    transform: scale(1.04);
  }

  .talk-address:focus-visible,
  .talk-copy-button:focus-visible {
    outline: 3px solid #182235;
    outline-offset: 4px;
    border-radius: 6px;
  }

  .talk-copy-button:focus-visible {
    border-radius: 999px;
  }

  /* Phones and small tablets: one column, as tall as its content, with
     the shape in the bottom right corner under the copy. */
  @media (max-width: 900px) {
    .talk-panel {
      grid-template-columns: 1fr;
      align-items: start;
      min-height: 0;
      padding-bottom: clamp(200px, 50vw, 340px);
    }
    .talk-glass {
      top: auto;
      bottom: -8%;
      right: -12%;
      width: clamp(240px, 62vw, 420px);
      translate: 0 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .talk-address,
    .talk-copy-button {
      transition: none;
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

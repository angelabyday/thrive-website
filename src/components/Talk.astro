---
/* "Talk to us": an orange panel, like the hero, so the page closes on the
   colour it opens with. The heading and copy on the left, the email
   address set large with a button to copy it. No form: people write to
   the address. */
interface Props {
  heading: string;
  body: string[];
  email: string;
}
const { heading, body, email } = Astro.props;
---

<section id="talk" class="talk">
  <div class="talk-panel" data-talk>

    <div class="talk-copy">
      <h2 class="talk-heading">{heading}</h2>
      {body.map((p) => <p class="talk-text">{p}</p>)}

      {/* The address in one big lozenge that opens an email; under it, a
          small button to copy the address instead. */}
      <a class="talk-pill" href={`mailto:${email}`}>
        <span class="talk-pill-text">{email}</span>
      </a>
      <button type="button" class="talk-copy-btn" data-copy={email}>
        <svg class="talk-copy-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="5.5" y="5.5" width="8" height="8" rx="1.8"></rect>
          <path d="M10.5 5.5V4.3A1.8 1.8 0 0 0 8.7 2.5H4.3A1.8 1.8 0 0 0 2.5 4.3v4.4a1.8 1.8 0 0 0 1.8 1.8h1.2"></path>
        </svg>
        <span data-copy-label>Copy email</span>
      </button>
      <span class="visually-hidden" aria-live="polite" data-copy-status></span>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  /* Opens out like a card, as "What we are" does: a little smaller with
     rounder corners as it comes up the screen, growing to full size as it
     scrolls in. Not for reduced motion. */
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLElement>('[data-talk]').forEach((panel) => {
      gsap.fromTo(
        panel,
        { scale: 0.74, borderRadius: () => Math.min(96, window.innerWidth * 0.06) },
        {
          scale: 1,
          borderRadius: () => Math.min(28, Math.max(16, window.innerWidth * 0.018)),
          ease: 'power1.inOut',
          scrollTrigger: {
            trigger: panel,
            start: 'top 95%',
            end: 'top 10%',
            scrub: true,
            invalidateOnRefresh: true,
          },
        },
      );
    });
  }

  document.querySelectorAll<HTMLElement>('[data-talk]').forEach((panel) => {
    /* The small button under the lozenge copies the address, and says
       "Copied" for a moment. */
    const button = panel.querySelector<HTMLButtonElement>('[data-copy]');
    const label = panel.querySelector<HTMLElement>('[data-copy-label]');
    const status = panel.querySelector<HTMLElement>('[data-copy-status]');
    if (!button || !label) return;
    let reset = 0;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        label.textContent = 'Copied';
        if (status) status.textContent = 'Email address copied';
      } catch {
        label.textContent = 'Press Ctrl or ⌘ + C';
      }
      window.clearTimeout(reset);
      reset = window.setTimeout(() => {
        label.textContent = 'Copy email';
        if (status) status.textContent = '';
      }, 1800);
    });
  });
</script>

<style>
  /* Desktop: the border round the panel a fifth wider. */
  @media (min-width: 1024px) {
    .talk {
      --gutter: clamp(29px, 3.6vw, 58px) !important;
    }
  }

  .talk {
    --gutter: clamp(24px, 3vw, 48px);
    padding: var(--gutter);
    /* Plus the footer's corner radius, as the footer tucks up under this
       by that much, so the gap below the panel matches the sides. */
    padding-bottom: calc(var(--gutter) + clamp(16px, 1.8vw, 28px));
    background: #fff2e6;
  }

  .talk-panel {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    min-height: clamp(420px, 64svh, 720px);
    /* Less the gap round the panel, so the content lines up with the
       other sections. */
    padding: clamp(48px, 6vw, 112px) max(16px, calc(var(--pad-x) - var(--gutter)));
    border-radius: clamp(16px, 1.8vw, 28px);
    background: #eb573d;
    color: #f9e07a;
  }

  /* Everything centred: heading, copy and the email lozenge. */
  .talk-copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(16px, 1.6vw, 24px);
    text-align: center;
  }

  .talk-heading {
    margin: 0 0 clamp(8px, 1vw, 16px);
    font-size: clamp(40px, 5.6vw, 104px);
    letter-spacing: -0.01em;
  }

  .talk-text {
    max-width: 30em;
    margin: 0;
    font-size: clamp(18px, 1.5vw, 24px);
    line-height: 1.26;
    text-wrap: pretty;
  }

  /* The address, large, with the copy button beside it. */
  /* The lozenge: yellow with orange type on the orange panel, the
     address set big. "Copied" sits in the same spot, so the lozenge
     keeps its size when the text swaps. */
  .talk-pill {
    display: inline-grid;
    /* Its own width, in the copy's column. */
    align-self: center;
    place-items: center;
    max-width: 100%;
    margin-top: clamp(16px, 2vw, 32px);
    padding: 0.32em 0.7em 0.38em;
    border: 0;
    border-radius: 999px;
    background: #f9e07a;
    color: #eb573d;
    font-family: 'Tumla', 'Albert Sans', system-ui, sans-serif;
    font-weight: 700;
    /* Big, but always small enough to keep the address on one line. */
    font-size: clamp(18px, 5.4vw, 96px);
    line-height: 1;
    letter-spacing: -0.01em;
    cursor: pointer;
    transition: transform 0.25s cubic-bezier(0.3, 0.7, 0.2, 1);
  }

  .talk-pill:hover {
    transform: scale(1.02);
  }

  .talk-pill:active {
    transform: scale(0.98);
  }

  .talk-pill-text {
    grid-area: 1 / 1;
    white-space: nowrap;
    transition: opacity 0.2s ease, transform 0.3s cubic-bezier(0.3, 0.7, 0.2, 1);
  }

  .talk-pill {
    text-decoration: none;
  }

  /* The small copy button: yellow type and icon straight on the orange. */
  .talk-copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    margin: 0;
    padding: 0.3em 0.2em;
    border: 0;
    background: none;
    color: #f9e07a;
    font: inherit;
    font-size: clamp(15px, 1.1vw, 18px);
    font-weight: 500;
    cursor: pointer;
  }

  .talk-copy-icon {
    width: 1.05em;
    height: 1.05em;
  }

  .talk-copy-btn:hover span {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .talk-copy-btn:focus-visible {
    outline: 2px solid #f9e07a;
    outline-offset: 3px;
    border-radius: 6px;
  }

  .talk-pill:focus-visible {
    outline: 3px solid #182235;
    outline-offset: 4px;
  }

  /* 30% less between paragraphs than the copy's gap. */
  .talk-text + .talk-text {
    margin-top: calc(-0.3 * clamp(16px, 1.6vw, 24px));
  }

  /* Phones and small tablets: as tall as its content. */
  @media (max-width: 900px) {
    .talk-panel {
      align-items: start;
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .talk-pill,
    .talk-pill-text {
      transition: none;
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

---
/* "Talk to us": an orange panel, like the hero, so the page closes on the
   colour it opens with. The heading and copy on the left, the email
   address set large with a button to copy it. No form: people write to
   the address. */
interface Props {
  heading: string;
  body: string[];
  email: string;
}
const { heading, body, email } = Astro.props;
---

<section id="talk" class="talk">
  <div class="talk-panel" data-talk>

    <div class="talk-copy">
      <h2 class="talk-heading">{heading}</h2>
      {body.map((p) => <p class="talk-text">{p}</p>)}

      {/* The address in one big lozenge: a click copies it, and the
          lozenge says "Copied" for a moment, keeping its size. */}
      <button type="button" class="talk-pill" data-copy={email} aria-label={`Copy email address ${email}`}>
        <span class="talk-pill-text" data-copy-address>{email}</span>
        <span class="talk-pill-text talk-pill-done" aria-hidden="true">Copied</span>
      </button>
      <span class="visually-hidden" aria-live="polite" data-copy-status></span>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-talk]').forEach((panel) => {
    const button = panel.querySelector<HTMLButtonElement>('[data-copy]');
    const status = panel.querySelector<HTMLElement>('[data-copy-status]');
    if (!button) return;
    let reset = 0;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
      } catch {
        /* No clipboard: open an email instead. */
        window.location.href = `mailto:${button.dataset.copy ?? ''}`;
        return;
      }
      button.toggleAttribute('data-copied', true);
      if (status) status.textContent = 'Email address copied';
      window.clearTimeout(reset);
      reset = window.setTimeout(() => {
        button.toggleAttribute('data-copied', false);
        if (status) status.textContent = '';
      }, 1800);
    });
  });
</script>

<style>
  .talk {
    --gutter: clamp(24px, 3vw, 48px);
    padding: var(--gutter);
    background: #fff2e6;
  }

  .talk-panel {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    min-height: clamp(420px, 64svh, 720px);
    /* Less the gap round the panel, so the content lines up with the
       other sections. */
    padding: clamp(48px, 6vw, 112px) max(16px, calc(var(--pad-x) - var(--gutter)));
    border-radius: clamp(16px, 1.8vw, 28px);
    background: #eb573d;
    color: #f9e07a;
  }

  .talk-copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 1.6vw, 24px);
  }

  .talk-heading {
    margin: 0 0 clamp(8px, 1vw, 16px);
    font-size: clamp(40px, 5.6vw, 104px);
    letter-spacing: -0.01em;
  }

  .talk-text {
    max-width: 30em;
    margin: 0;
    font-size: clamp(18px, 1.5vw, 24px);
    line-height: 1.4;
    text-wrap: pretty;
  }

  /* The address, large, with the copy button beside it. */
  /* The lozenge: yellow with orange type on the orange panel, the
     address set big. "Copied" sits in the same spot, so the lozenge
     keeps its size when the text swaps. */
  .talk-pill {
    display: inline-grid;
    /* Its own width, in the copy's column. */
    align-self: flex-start;
    place-items: center;
    max-width: 100%;
    margin-top: clamp(16px, 2vw, 32px);
    padding: 0.32em 0.7em 0.38em;
    border: 0;
    border-radius: 999px;
    background: #f9e07a;
    color: #eb573d;
    font-family: 'Tumla', 'Albert Sans', system-ui, sans-serif;
    font-weight: 700;
    /* Big, but always small enough to keep the address on one line. */
    font-size: clamp(18px, 5.4vw, 96px);
    line-height: 1;
    letter-spacing: -0.01em;
    cursor: pointer;
    transition: transform 0.25s cubic-bezier(0.3, 0.7, 0.2, 1);
  }

  .talk-pill:hover {
    transform: scale(1.02);
  }

  .talk-pill:active {
    transform: scale(0.98);
  }

  .talk-pill-text {
    grid-area: 1 / 1;
    white-space: nowrap;
    transition: opacity 0.2s ease, transform 0.3s cubic-bezier(0.3, 0.7, 0.2, 1);
  }

  .talk-pill-done {
    opacity: 0;
    transform: translateY(0.3em);
  }

  .talk-pill[data-copied] [data-copy-address] {
    opacity: 0;
    transform: translateY(-0.3em);
  }

  .talk-pill[data-copied] .talk-pill-done {
    opacity: 1;
    transform: none;
  }

  .talk-pill:focus-visible {
    outline: 3px solid #182235;
    outline-offset: 4px;
  }

  /* Phones and small tablets: as tall as its content. */
  @media (max-width: 900px) {
    .talk-panel {
      align-items: start;
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .talk-pill,
    .talk-pill-text {
      transition: none;
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
